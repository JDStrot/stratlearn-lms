# Copy this file to .env.local for local development.
# On Vercel, paste each of these under Project > Settings > Environment Variables.

# Supabase > Project Settings > API (or "Connect" button) > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API Keys > "anon" / publishable key (safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase > Project Settings > API Keys > "service_role" / secret key
# KEEP SECRET. Server only. Never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string (at least 32 characters). Signs learner login cookies.
# Generate one at https://generate-secret.vercel.app/32 or with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
